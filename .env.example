FERRO_DATABASE_URL=postgres://ferro:ferro@localhost:5432/ferro
# Optional when URL scheme is unrecognized: postgres | sqlite | mysql
# FERRO_DATABASE_KIND=postgres
# Local SQLite (migrations only until full backend support): sqlite://./ferro.db
# at least 32 random characters, e.g. `openssl rand -hex 32`
FERRO_SECRET=change-me-change-me-change-me-change-me
FERRO_ENV=local
FERRO_BIND=0.0.0.0:8055
FERRO_STORAGE_LOCAL_ROOT=./uploads
FERRO_ADMIN_EMAIL=admin@example.com
FERRO_ADMIN_PASSWORD=change-me-please
FERRO_CORS_ORIGINS=http://localhost:3000
FERRO_ADMIN_DIR=./admin
FERRO_EXTENSIONS_DIR=./examples/site/extensions
# secrets for flows, used as {{ $env.PUBLISH_HOOK_TOKEN }}
FERRO_FLOW_ENV_PUBLISH_HOOK_TOKEN=change-me
FERRO_LOG=info

# Full env reference: docs/CONFIGURATION.md
# Multi-env CLI (ferro.toml): docs/ENVIRONMENT.md — set FERRO_DEV_TOKEN, FERRO_PROD_TOKEN, etc.

# AI assistant (admin chat) — see docs/AI_ASSISTANT.md
# FERRO_AI_ENABLED=true
# FERRO_AI_API_KEY=sk-...
# FERRO_AI_BASE_URL=https://api.openai.com/v1
# FERRO_AI_MODEL=gpt-4o-mini
# FERRO_AI_MAX_ROUNDS=12
